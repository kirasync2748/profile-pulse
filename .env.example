# Upstash Redis REST API credentials (production / Vercel).
# Get these from your Upstash console: https://console.upstash.com
# Create a database, then copy the REST URL and REST token.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Standard Redis URL for local development only (optional).
# When set and no Upstash credentials are present, the local server uses this
# Redis instance instead of Upstash REST.
# Example: redis://localhost:6379
REDIS_URL=

# Server listen address (optional, defaults to :3000).
# In production (Vercel Go Framework preset) the platform sets PORT as a bare
# port number; the server listens on it automatically. ADDR is for local dev
# only and is ignored when PORT is set.
ADDR=:3000
